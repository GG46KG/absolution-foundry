{{! Character Tab: the stat columns of the Absolution character sheet. Skills are on their own tab. }}
<section class='tab stats {{tab.cssClass}}' data-group='primary' data-tab='stats'>
  <div class='stats-grid'>

    <div class='stats-column'>
      <fieldset>
        <legend>{{localize 'ABSOLUTION.Actor.Sections.Attributes'}}</legend>
        {{#each system.attributes as |attribute key|}}
          <div class='stat-row'>
            <a class='roll-die' data-action='roll' data-roll-type='attribute' data-key='{{key}}' aria-label='{{localize "ABSOLUTION.Check.Roll"}}'><i class='fa-solid fa-dice-d6'></i></a>
            <label>{{attribute.label}}</label>
            <input type='number' name='system.attributes.{{key}}.value' value='{{attribute.value}}' min='0' />
          </div>
        {{/each}}
      </fieldset>

      <fieldset>
        <legend>{{localize 'ABSOLUTION.Actor.Sections.Defenses'}}</legend>
        {{#if system.wornArmor.name}}
          <div class='stat-row armor-worn {{#if (gt system.wornArmor.count 1)}}warning{{/if}}'>
            <span>
              {{localize 'ABSOLUTION.Actor.Wearing' name=system.wornArmor.name}}
              {{#if (gt system.wornArmor.count 1)}}{{localize 'ABSOLUTION.Actor.WearingMany'}}{{/if}}
            </span>
          </div>
        {{/if}}
        <div class='stat-row'>
          <label>{{localize 'ABSOLUTION.Actor.base.FIELDS.speed.label'}}</label>
          <input type='number' name='system.speed' value='{{system.speed}}' min='0' />
        </div>
        {{#if (ne system.speedTotal system.speed)}}
          <div class='stat-row sub-entry modified'>
            <i class='fa-solid fa-turn-up fa-rotate-90 sub-entry-marker'></i>
            <label>{{localize 'ABSOLUTION.Actor.ModifiedByArmor'}}</label>
            <span class='derived'>{{system.speedTotal}}</span>
          </div>
        {{/if}}
        <div class='stat-row'>
          <label>{{localize 'ABSOLUTION.Actor.base.FIELDS.armor.label'}}</label>
          <input type='number' name='system.armor' value='{{system.armor}}' min='0' />
        </div>
        {{#if (ne system.armorTotal system.armor)}}
          <div class='stat-row sub-entry modified'>
            <i class='fa-solid fa-turn-up fa-rotate-90 sub-entry-marker'></i>
            <label>{{localize 'ABSOLUTION.Actor.ModifiedByArmor'}}</label>
            <span class='derived'>{{system.armorTotal}}</span>
          </div>
        {{/if}}
        <div class='stat-row'>
          <label>{{localize 'ABSOLUTION.Actor.base.FIELDS.evasion.label'}}</label>
          <input type='number' name='system.evasion' value='{{system.evasion}}' />
        </div>
        {{#if (ne system.evasionTotal system.evasion)}}
          <div class='stat-row sub-entry modified'>
            <i class='fa-solid fa-turn-up fa-rotate-90 sub-entry-marker'></i>
            <label>{{localize 'ABSOLUTION.Actor.ModifiedByArmor'}}</label>
            <span class='derived'>{{system.evasionTotal}}</span>
          </div>
        {{/if}}
        <div class='stat-row'>
          <label>{{localize 'ABSOLUTION.Actor.Resistance'}}</label>
          <span class='derived'>{{system.resistance}}</span>
        </div>
      </fieldset>

      <fieldset class='damage-reduction'>
        <legend>{{localize 'ABSOLUTION.DamageReduction.Title'}}</legend>
        <div class='dr-row dr-header'>
          <span class='dr-value'>{{localize 'ABSOLUTION.DamageReduction.Amount'}}</span>
          <span class='dr-type'>{{localize 'ABSOLUTION.DamageReduction.Type'}}</span>
          <span class='dr-source'>{{localize 'ABSOLUTION.DamageReduction.Source'}}</span>
          <span class='dr-controls'>
            {{#if editable}}
              <a data-action='addDamageReduction' aria-label='{{localize "ABSOLUTION.DamageReduction.Add"}}'><i class='fas fa-plus'></i></a>
            {{/if}}
          </span>
        </div>
        {{! Worked out from Armor Rating; change Armor Rating or armor to change these }}
        {{#each system.armorReductions as |row|}}
          <div class='dr-row dr-auto'>
            <span class='dr-value'>{{row.value}}</span>
            <span class='dr-type'>{{row.type}}</span>
            <span class='dr-source'>{{row.source}}</span>
            <span class='dr-controls'><i class='fa-solid fa-lock'></i></span>
          </div>
        {{/each}}
        {{#each system.damageReductions as |row index|}}
          <div class='dr-row'>
            <input class='dr-value' type='number' name='system.damageReductions.{{index}}.value' value='{{row.value}}' min='0' />
            <input class='dr-type' type='text' name='system.damageReductions.{{index}}.type' value='{{row.type}}' list='absolution-damage-types' placeholder='{{localize "ABSOLUTION.DamageReduction.TypePlaceholder"}}' />
            <input class='dr-source' type='text' name='system.damageReductions.{{index}}.source' value='{{row.source}}' />
            <span class='dr-controls'>
              {{#if @root.editable}}
                <a data-action='deleteDamageReduction' data-index='{{index}}' aria-label='{{localize "ABSOLUTION.DamageReduction.Delete"}}'><i class='fas fa-trash'></i></a>
              {{/if}}
            </span>
          </div>
        {{/each}}
        <datalist id='absolution-damage-types'>
          {{#each damageTypes as |label|}}<option value='{{label}}'></option>{{/each}}
        </datalist>
      </fieldset>
    </div>

    <div class='stats-column'>
      <fieldset>
        <legend>{{localize 'ABSOLUTION.Actor.Sections.Stamina'}}</legend>
        {{#if isCharacter}}
          <div class='stat-row'>
            <label>{{localize 'ABSOLUTION.Actor.StaminaBase'}}</label>
            <span class='derived'>{{system.stamina.base}}</span>
          </div>
          <div class='stat-row'>
            <label>{{localize 'ABSOLUTION.Actor.StaminaGrowth'}}</label>
            <span class='derived'>{{system.stamina.growth}}</span>
          </div>
          <div class='stat-row'>
            <label>{{localize 'ABSOLUTION.Actor.Character.FIELDS.stamina.bonus.label'}}</label>
            <input type='number' name='system.stamina.bonus' value='{{system.stamina.bonus}}' />
          </div>
          <div class='stat-row'>
            <label>{{localize 'ABSOLUTION.Actor.Character.FIELDS.tough.label'}}</label>
            <input type='checkbox' name='system.tough' {{checked system.tough}} />
          </div>
          <div class='stat-row'>
            <label>{{localize 'ABSOLUTION.Actor.StaminaMax'}}</label>
            <span class='derived'>{{system.stamina.max}}</span>
          </div>
        {{else}}
          <div class='stat-row'>
            <label>{{localize 'ABSOLUTION.Actor.base.FIELDS.stamina.max.label'}}</label>
            <input type='number' name='system.stamina.max' value='{{system.stamina.max}}' min='0' />
          </div>
        {{/if}}
        <div class='stat-row'>
          <label>{{localize 'ABSOLUTION.Actor.base.FIELDS.stamina.value.label'}}</label>
          <input type='number' name='system.stamina.value' value='{{system.stamina.value}}' min='0' />
        </div>
        <div class='stat-row'>
          <label>{{localize 'ABSOLUTION.Actor.base.FIELDS.barrier.label'}}</label>
          <input type='number' name='system.barrier' value='{{system.barrier}}' min='0' />
        </div>
      </fieldset>

      <fieldset>
        <legend>{{localize 'ABSOLUTION.Actor.Sections.Wounds'}}</legend>
        <div class='stat-row'>
          <label>{{localize 'ABSOLUTION.Actor.base.FIELDS.wounds.normal.label'}}</label>
          <input type='number' name='system.wounds.normal' value='{{system.wounds.normal}}' min='0' />
        </div>
        <div class='stat-row'>
          <label>{{localize 'ABSOLUTION.Actor.base.FIELDS.wounds.grievous.label'}}</label>
          <input type='number' name='system.wounds.grievous' value='{{system.wounds.grievous}}' min='0' />
        </div>
        <div class='stat-row'>
          <label>{{localize 'ABSOLUTION.Actor.base.FIELDS.wounds.status.label'}}</label>
          <select name='system.wounds.status'>
            {{selectOptions choices.statuses selected=system.wounds.status localize=true}}
          </select>
        </div>
        <div class='stat-row'>
          <label>{{localize 'ABSOLUTION.Actor.base.FIELDS.wounds.mortal.label'}}</label>
          <input type='checkbox' name='system.wounds.mortal' {{checked system.wounds.mortal}} />
        </div>
      </fieldset>
    </div>

  </div>
</section>
