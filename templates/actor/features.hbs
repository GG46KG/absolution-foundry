{{! Features Tab: vow features and traits in one list. NPC features have no source. }}
<section class='tab features {{tab.cssClass}}' data-group='primary' data-tab='features'>
  {{> 'systems/absolution/templates/actor/parts/action-list.hbs'
    listId='features'
    type='feature'
    newLabel='ABSOLUTION.Actor.NewFeature'
    items=features
    showSource=isCharacter
  }}
</section>
